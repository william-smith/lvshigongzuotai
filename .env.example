# ============================================================
# 留空 = 使用本地演示数据（src/data/demo.json），不建库也能看
# 填写 = 连接你自己的云端数据库
#
# 数据层只依赖 PostgREST 标准接口，不绑定任何厂商。
# 下面三家任选其一，填「接口地址 + 密钥」即可，切换零改代码。
# ============================================================

# ① 腾讯云 CloudBase for Supabase 版（推荐：境内、大厂、上海地域）
#    控制台 → 环境 → 连接信息 / API 密钥
# VITE_API_BASE=https://xxxx.ap-shanghai.app.tcloudbase.com/rest/v1
# VITE_API_KEY=你的密钥

# ② MemFire Cloud（国产 Supabase 架构，免费 512MB + 1GB/月流量）
# VITE_API_BASE=https://xxxx.memfiredb.com/rest/v1
# VITE_API_KEY=你的密钥

# ③ Supabase（境外，永久免费但数据出境）
# VITE_API_BASE=https://xxxxx.supabase.co/rest/v1
# VITE_API_KEY=eyJhbGciOi...

# 本地演示数据的解锁口令（换成你自己的，改完需重跑 scripts/migrate_noco.py）
VITE_DEMO_PASSPHRASE=demo-2026

# 登录邮箱（可选，仅用于登录页预填）
# 填上 VITE_API_BASE 之后，打开页面会先要求登录：
#   1. node scripts/setup_auth.mjs --token sbp_xxx   ← 建账号 + 收紧权限
#   2. 用脚本输出的邮箱密码登录
# 不填也能用，只是每次要手输邮箱
# VITE_AUTH_EMAIL=you@example.com
