# Radicale 配置（v3 风格）
# 文档：https://radicale.org/v3.html

[server]
hosts = 0.0.0.0:5232
# 反代场景下配合 X-Script-Name 头使用（Kong 那条 /dav 路由会带）

[auth]
type = htpasswd
htpasswd_filename = /config/users
# 明文口令。仅用于反代后的 HTTPS 场景；如需更高安全改为 bcrypt 重新生成 users
htpasswd_encryption = plain

[storage]
filesystem_folder = /data/collections

[rights]
type = owner_only

[logging]
level = info

[web]
type = none
